# Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only secrets: configure in Render, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=SET_IN_SERVER_ENVIRONMENT
META_APP_ID=YOUR_META_APP_ID
META_EMBEDDED_SIGNUP_CONFIG_ID=YOUR_META_EMBEDDED_SIGNUP_V4_CONFIG_ID
META_APP_SECRET=SET_IN_SERVER_ENVIRONMENT
META_WEBHOOK_VERIFY_TOKEN=GENERATE_A_LONG_RANDOM_VALUE
WHATSAPP_TOKEN_ENCRYPTION_KEY=BASE64_ENCODED_32_BYTE_KEY
META_GRAPH_API_VERSION=v23.0
APP_BASE_URL=http://localhost:3000
# Must be a server-only Supabase service_role key for signed webhook writes and server-side token storage.
# SUPABASE_SERVICE_ROLE_KEY must never use the NEXT_PUBLIC_ prefix.

# Comma-separated email allowlist for the platform admin route (server-only)
ADMIN_EMAILS=your-admin-email@example.com
