# Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only secrets: configure in Vercel, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=SET_IN_SERVER_ENVIRONMENT
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=SET_IN_SERVER_ENVIRONMENT
META_WEBHOOK_VERIFY_TOKEN=GENERATE_A_LONG_RANDOM_VALUE
META_GRAPH_API_VERSION=v23.0
APP_BASE_URL=http://localhost:3000
